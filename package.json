{
  "name": "claude-status",
  "displayName": "Claude Status",
  "description": "Shows Claude service status from status.claude.com in the status bar.",
  "version": "0.1.0",
  "publisher": "MiscoDEV",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeStatus.refresh",
        "title": "Claude Status: Refresh"
      },
      {
        "command": "claudeStatus.openStatus",
        "title": "Claude Status: Open status page"
      }
    ],
    "configuration": {
      "title": "Claude Status",
      "properties": {
        "claudeStatus.refreshIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 120,
          "description": "How often to refresh Claude status (minutes)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "npm run compile && node out/status.check.js",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository",
    "install:cursor": "npm run package && cursor --install-extension ./claude-status-0.1.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
